# GuardianAI Enterprise Configuration Example
# Copy this file to .env for local testing (Never commit actual passwords or .env)

# Server Configuration
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8000
GUARDIAN_ENABLED=true

# Security Signing Keys (Development keys for demo)
GUARDIAN_SECRET_KEY=GUARDIAN_DEV_HMAC_SECRET_KEY_DO_NOT_USE_IN_PROD
CAPABILITY_TOKEN_SECRET=GUARDIAN_DEV_CAPABILITY_SIGNING_SECRET_KEY
AUTH_SECRET_KEY=GUARDIAN_AUTH_SESSION_SECRET_KEY_DEV

# Capability & Approval TTLs
CAPABILITY_TTL_SECONDS=60
APPROVAL_TTL_SECONDS=300

# Authentication & OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
AUTH_SESSION_TTL_HOURS=24

# SMTP Email Notification Settings
# Administrator / Sender Email
GUARDIAN_SMTP_EMAIL=thatigiripavankumar@gmail.com
# Gmail 16-character App Password (Leave blank for local DEV mode with simulated OTP & incident alerts)
GUARDIAN_SMTP_APP_PASSWORD=
GUARDIAN_SMTP_HOST=smtp.gmail.com
GUARDIAN_SMTP_PORT=587
DEFAULT_NOTIFICATION_EMAIL=thatigiripavankumar@gmail.com

# LLM Provider Configuration (Optional for mock / local demo)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=DEMO_ONLY_FAKE_KEY

# Safe Demonstration Fake Secrets (Never use real production secrets)
DEMO_API_KEY=GUARDIAN_FAKE_SECRET_12345

# Database Configuration
DATABASE_URL=sqlite:///./guardianai.db
DATABASE_RO_URL=sqlite:///./guardianai.db

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:5173
